    {
      "annotation_marker": "g1",
      "annotation_type": "footnote",
      "annotation_text": "This SoA shows visits and procedures unique to the intervention-specific appendix (ISA) H0P-MC-NP01 (NP01) for LY3016859. Please refer to master protocol H0P-MC-CPMP (CPMP) and the diabetic peripheral neuropathic pain (DPNP) disease-state addendum (DSA) H0P-MC-CPMP(3) SoAs for additional information.",
      "marker_locations": [
        {
          "table_number": 1,
          "location_type": "schedule_property",
          "row_position": 1,
          "method": "synthesized"
        }
      ]
    },
    {
      "annotation_marker": "n1",
      "annotation_type": "footnote",
      "annotation_text": "Minimal interval between 2 doses cannot be shorter than 11 days.",
      "marker_locations": [
        {
          "table_number": 1,
          "location_type": "schedule_property",
          "row_position": 4,
          "method": "synthesized"
        }
      ]
    },
    {
      "annotation_marker": "n2",
      "annotation_type": "footnote",
      "annotation_text": "Targeted exam for skin, eyes, mouth, lungs and GI tract should be performed at each visit, in addition to any symptom driven exam.",
      "marker_locations": [
        {
          "table_number": 1,
          "location_type": "activity_name",
          "row_position": 5,
          "method": "synthesized"
        }
      ]
    },
    {
      "annotation_marker": "n3",
      "annotation_type": "footnote",
      "annotation_text": "Full physical exam should be performed at Visit 803 or ED.",
      "marker_locations": [
        {
          "table_number": 1,
          "location_type": "schedule_cell",
          "row_position": 5,
          "column_position": 9,
          "method": "text_match"
