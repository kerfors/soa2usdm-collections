 "annotations": [
  {
   "annotation_marker": "g1",
   "annotation_type": "footnote",
   "annotation_text": "The pharmacokinetic sampling table applies to all participants irrespective of 21-day or 28-day cycle length.",
   "marker_locations": [
    {
     "table_number": 3,
     "location_type": "schedule_property",
     "row_position": 1,
     "method": "synthesized"
    }
   ],
   "annotation_text_source": {
    "method": "visual_transcription",
    "note": "'General Instructions' paragraphs printed above the table in Section 1.3.1 on page 24 (outside the grid); image-only PDF."
   }
  },
  {
   "annotation_marker": "g2",
   "annotation_type": "footnote",
   "annotation_text": "Adequately record the actual collection date and time (24-hour clock; for example, 16:00, not 4 pm) on the requisition form of the sample.",
   "marker_locations": [
    {
     "table_number": 3,
     "location_type": "schedule_property",
     "row_position": 1,
     "method": "synthesized"
    }
   ],
   "annotation_text_source": {
    "method": "visual_transcription",
    "note": "'General Instructions' paragraphs printed above the table in Section 1.3.1 on page 24 (outside the grid); image-only PDF."
   }
  },
  {
   "annotation_marker": "g3",
   "annotation_type": "footnote",
   "annotation_text": "In case of cycle delay and/or ramucirumab dosing interruption, if possible, collect an additional unscheduled PK samples using the appropriate central lab collection kit:\n• at time as close as possible to the onset of the adverse event (AE) (if the cycle delay or ramucirumab dosing interruption is due to an AE).\n• at the time when ramucirumab dose should have been administered (if there had not been a delay or dose interruption).\n• prior to resuming the ramucirumab dosing after dosing interruption/dosing delay.",
   "marker_locations": [
    {
     "table_number": 3,
     "location_type": "schedule_property",
     "row_position": 1,
     "method": "synthesized"
    }
   ],
   "annotation_text_source": {
    "method": "visual_transcription",
    "note": "'General Instructions' paragraphs printed above the table in Section 1.3.1 on page 24 (outside the grid); image-only PDF."
   }
  },
  {
   "annotation_marker": "g4",
   "annotation_type": "footnote",
   "annotation_text": "Note: If the above time points for unscheduled PK sampling happen to occur at the same time as a scheduled PK time point (see table below), then only the scheduled sample will be taken.",
   "marker_locations": [
