  "annotations": [
    {
      "annotation_marker": "a",
      "annotation_type": "footnote",
      "annotation_text": "Randomization to occur within 4 weeks of the Screening Visit. The Randomization Visit may be a televisit or an in-clinic visit.",
      "marker_locations": [
        {
          "table_number": 1,
          "location_type": "schedule_cell",
          "row_position": 1,
          "column_position": 3
        }
      ]
    },
    {
      "annotation_marker": "b",
      "annotation_type": "footnote",
      "annotation_text": "For each of the 3 eligible HAE attacks, a televisit will occur by the next working day after the completion of the patient diary (visit window: +1 week). A televisit must occur before treating the next eligible attack.",
      "marker_locations": [
        {
          "table_number": 1,
          "location_type": "schedule_cell",
          "row_position": 2,
          "column_position": 4
        },
        {
          "table_number": 1,
