        }
      ]
    },
    {
      "annotation_id": "annot-003",
      "table_id": "table-003",
      "annotation_marker": "3",
      "annotation_type": "footnote",
      "annotation_text": "The collection of blood samples for CBC and chemistry analysis, vital signs and weight may be collected during visit to local clinic or at in-home nursing visit when the study assessments are not performed in clinic.",
