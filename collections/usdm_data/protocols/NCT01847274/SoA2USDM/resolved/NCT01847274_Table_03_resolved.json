    {
      "annotation_id": "annot-004",
      "table_id": "table-003",
      "annotation_marker": "4",
      "annotation_type": "footnote",
      "annotation_text": "Footnote not printed in the source (Table 9 prints only footnotes 1-3); no confident Table 7 (Main Study) equivalent for this Vital signs cell in the 'Patient Visit to Local Clinic or In-Home Nursing' column. Clinical review 2026-08-15: remains unresolved — no Table 7 candidate (Table 7's vital-signs footnote is \"Height obtained at screening only\"); §7.4.1 confirms vital signs at the local clinic/in-home nursing visit, content already covered by printed footnote 3.",
      "annotation_scope": "cell",
      "referenced_elements": {
        "property_ids": [],
