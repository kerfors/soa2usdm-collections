    {
      "annotation_id": "annot-002",
      "table_id": "table-003",
      "annotation_marker": "2",
      "annotation_type": "footnote",
      "annotation_text": "The study coordinator will contact the patient by telephone to obtain information for the ECOG performance status, adverse event monitoring, and concomitant medications when the study assessments are not performed in clinic.",
