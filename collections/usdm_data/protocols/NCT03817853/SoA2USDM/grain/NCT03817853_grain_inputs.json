    "entry": {
     "name": "MD Anderson Symptom Inventory",
     "kind": "instrument",
     "abbreviation": "MDASI",
     "version": null,
     "type": "self-report measure",
     "respondent_or_rater": "patients (self-administered)",
     "recall_period": "in the last 24 hours",
     "mode": "paper questionnaires; self-administered at the clinic",
     "scoring_or_range": "13 symptom severity items and 6 interference items, each rated 0 (symptom has not been present / did not interfere) to 10 (as bad as you can imagine / interfered completely)",
     "purpose": "to assess symptom severity and interference",
     "soa_activities": [
      "Patient-reported measures"
     ],
     "evidence": [
      {
       "page": 56,
       "quote": "PRO data will be collected using the MD Anderson Symptom Inventory (MDASI) instrument (Appendix 2)."
      },
      {
       "page": 57,
       "quote": "the MDASI will be self-administered at the clinic at specified timepoints during the study (see schedule of activities in Appendix 1)."
      },
      {
       "page": 58,
       "quote": "The MD Anderson Symptom Inventory (MDASI; Appendix 2) is a validated and reliable self-report measure (Cleeland et al., 2000) that was developed to assess symptom severity and interference."
      },
      {
       "page": 58,
       "quote": "ask patients to rate how severe the symptoms were when “at their worst” in the last 24 hours."
      },
      {
       "page": 58,
       "quote": "An additional 6 items ask patients to rate how much the symptoms have interfered with 6 areas of function (i.e., general activity, walking, work, mood, relations with other people, and enjoyment of life) in the last 24 hours."
      },
      {
       "page": 91,
       "quote": "Patient- and provider-reported data will be collected on paper questionnaires."
      },
      {
       "page": 103,
       "quote": "Before administration of treatment at Day 1 of Cycles 1–6, at the end of induction, during maintenance, at end of maintenance, and at end of study, patients will complete the MDASI."
      },
      {
       "page": 104,
       "quote": "M.D. Anderson Symptom Inventory (MDASI) Core Items. Part I. How severe are your symptoms? ... Please fill in the circle below from 0 (symptom has not been present) to 10 (the symptom was as bad as you can imagine it could be) for each item.",
       "read_from": "page image"
      },
      {
       "page": 105,
       "quote": "Part II: How have your symptoms interfered with your life? ... 0 Did Not Interfere ... 10 Interfered Completely",
       "read_from": "page image"
      }
     ]
    }
   },
